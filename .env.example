# Clé secrète pour les routes d'administration (header X-Admin-Key)
ADMIN_KEY=CHANGE_THIS_SECRET_KEY_FOR_ADMIN

# Code d'accès pour l'outil collaboratif dev.scoutgame.ch (fallback sur ADMIN_KEY si non défini)
DEV_ACCESS_CODE=CHANGE_THIS_DEV_ACCESS_CODE

# Configuration SMTP (Infomaniak)
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=info@scoutgame.ch
SMTP_PASS=SECRET_INFOMANIAK_SMTP_PASSWORD

# Chemin vers la base de données SQLite (dans le volume Docker)
DB_PATH=/app/data/scoutgame.db
